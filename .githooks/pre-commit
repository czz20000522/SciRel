#!/bin/sh
# Run the staged-file check in the same Linux environment as CI.
root="$(git rev-parse --show-toplevel)"
if command -v python3 >/dev/null 2>&1; then
    exec python3 "$root/scripts/dev_container.py" precommit
fi
if command -v python >/dev/null 2>&1; then
    exec python "$root/scripts/dev_container.py" precommit
fi
if command -v py >/dev/null 2>&1; then
    exec py -3 "$root/scripts/dev_container.py" precommit
fi
echo "Python 3 is required to enter the SciRel development container." >&2
exit 127
