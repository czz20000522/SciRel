{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scirel.dev/contracts/reviewed-release-manifest-dev.schema.json",
  "title": "SciRel development exact reviewed release binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "release_id", "candidate_entry_id", "candidate_entry_digest", "candidate_id", "draft_id", "candidate_git_revision", "git_revision", "approved_items", "included_assets", "release_version", "catalog_ref", "catalog_digest", "wheel_ref", "wheel_digest", "verified_tests", "verified_test_run"],
  "properties": {
    "schema": {"const": "scirel.reviewed-release-manifest.dev"},
    "release_id": {"type": "string", "minLength": 1},
    "candidate_entry_id": {"type": "string", "minLength": 1},
    "candidate_entry_digest": {"$ref": "#/$defs/digest"},
    "candidate_id": {"type": "string", "minLength": 1},
    "draft_id": {"type": "string", "minLength": 1},
    "candidate_git_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "git_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "approved_items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["item_ref", "asset_id", "revision", "submitted_revision", "decision_digest"],
        "properties": {
          "item_ref": {"type": "string", "minLength": 1},
          "asset_id": {"type": "string", "minLength": 1},
          "revision": {"$ref": "#/$defs/digest"},
          "submitted_revision": {"$ref": "#/$defs/digest"},
          "decision_digest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "included_assets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "release_version": {"type": "string", "minLength": 1},
    "catalog_ref": {"type": "string", "minLength": 1},
    "catalog_digest": {"$ref": "#/$defs/digest"},
    "wheel_ref": {"type": "string", "minLength": 1},
    "wheel_digest": {"$ref": "#/$defs/digest"},
    "verified_tests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "verified_test_run": {
      "type": "object", "additionalProperties": false,
      "required": ["command", "exit_code", "stdout_digest", "stderr_digest"],
      "properties": {
        "command": {"type": "array", "minItems": 4, "items": {"type": "string"}},
        "exit_code": {"const": 0},
        "stdout_digest": {"$ref": "#/$defs/digest"},
        "stderr_digest": {"$ref": "#/$defs/digest"}
      }
    }
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
