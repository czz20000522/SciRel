{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scirel.dev/contracts/review-decision-dev.schema.json",
  "title": "SciRel development review decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "draft_id", "outcome", "reviewer", "notes"],
  "properties": {
    "schema": {"const": "scirel.review-decision.dev"},
    "draft_id": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["approved", "needs_evidence", "rework_requested", "rejected"]},
    "reviewer": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}
  }
}
