{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scirel.dev/contracts/l1-bundle-dev.schema.json",
  "title": "SciRel content-addressed L1 project bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project_id",
    "bundle_digest",
    "file_count",
    "total_bytes",
    "files"
  ],
  "properties": {
    "schema": {"const": "scirel.l1-bundle.dev"},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "bundle_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "file_count": {"type": "integer", "minimum": 1, "maximum": 4096},
    "total_bytes": {"type": "integer", "minimum": 0, "maximum": 10485760},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest", "size", "content_base64"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 1024},
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "size": {"type": "integer", "minimum": 0, "maximum": 4194304},
          "content_base64": {"type": "string", "contentEncoding": "base64"}
        }
      }
    }
  }
}
