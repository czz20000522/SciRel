{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scirel.dev/contracts/release-index-dev.schema.json",
  "title": "SciRel development candidate and released version index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "entries"],
  "properties": {
    "schema": {"const": "scirel.release-index.dev"},
    "entries": {
      "type": "array",
      "items": {"oneOf": [{"$ref": "#/$defs/candidate"}, {"$ref": "#/$defs/released"}]}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "entry_digest", "status", "candidate_id", "draft_id", "git_revision", "items"],
      "properties": {
        "entry_id": {"type": "string", "pattern": "^candidate:[0-9a-f]{64}$"},
        "entry_digest": {"$ref": "#/$defs/digest"},
        "status": {"const": "candidate"},
        "candidate_id": {"type": "string", "minLength": 1},
        "draft_id": {"type": "string", "minLength": 1},
        "git_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "items": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["item_ref", "initial_revision", "asset_id", "document_digest", "dependency_asset_ids"],
            "properties": {
              "item_ref": {"type": "string", "minLength": 1},
              "initial_revision": {"$ref": "#/$defs/digest"},
              "asset_id": {"type": "string", "minLength": 1},
              "document_digest": {"$ref": "#/$defs/digest"},
              "dependency_asset_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "released": {
      "type": "object", "additionalProperties": false,
      "required": ["entry_id", "entry_digest", "status", "predecessor_entry_id", "baseline_entry_id", "included_assets", "manifest_digest"],
      "properties": {
        "entry_id": {"type": "string", "pattern": "^release:.+$"},
        "entry_digest": {"$ref": "#/$defs/digest"},
        "status": {"const": "released"},
        "predecessor_entry_id": {"type": "string", "pattern": "^candidate:[0-9a-f]{64}$"},
        "baseline_entry_id": {"type": ["string", "null"]},
        "included_assets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "manifest_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
