{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scirel.dev/contracts/release-index-dev.schema.json",
  "title": "SciRel unpublished candidate, lifecycle, evidence and released version index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "entries"],
  "properties": {
    "schema": {"const": "scirel.release-index.dev"},
    "entries": {
      "type": "array",
      "items": {"oneOf": [{"$ref": "#/$defs/candidate"}, {"$ref": "#/$defs/development"}, {"$ref": "#/$defs/evidence"}, {"$ref": "#/$defs/lifecycle"}, {"$ref": "#/$defs/released"}]}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifact_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "digest"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"},
        "root_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "entry_digest", "status", "candidate_id", "draft_id", "git_revision", "items"],
      "properties": {
        "entry_id": {"type": "string", "pattern": "^candidate:[0-9a-f]{64}$"},
        "entry_digest": {"$ref": "#/$defs/digest"},
        "status": {"const": "candidate"},
        "candidate_id": {"type": "string", "minLength": 1},
        "draft_id": {"type": "string", "minLength": 1},
        "git_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "approval_state": {"const": "pending_unapproved"},
        "source_qualification": {"enum": ["bounded_d1", "mixed_unverified"]},
        "destination": {"const": "review_host"},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/artifact_ref"}},
        "destination_refs": {"type": "array", "items": {"$ref": "#/$defs/artifact_ref"}},
        "items": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["item_ref", "initial_revision", "asset_id", "document_digest", "dependency_asset_ids"],
            "properties": {
              "item_ref": {"type": "string", "minLength": 1},
              "initial_revision": {"$ref": "#/$defs/digest"},
              "asset_id": {"type": "string", "minLength": 1},
              "document_digest": {"$ref": "#/$defs/digest"},
              "dependency_asset_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "development": {
      "type": "object", "additionalProperties": false,
      "required": ["entry_id", "entry_digest", "status", "snapshot_id", "approval_state", "source_qualification", "source_binding", "catalog", "wheel", "evidence_refs", "destination_refs"],
      "properties": {
        "entry_id": {"type": "string", "pattern": "^development:[0-9a-f]{64}$"},
        "entry_digest": {"$ref": "#/$defs/digest"},
        "status": {"const": "development"},
        "snapshot_id": {"type": "string", "minLength": 1},
        "approval_state": {"const": "pending_unapproved"},
        "source_qualification": {"enum": ["bounded_d1", "mixed_unverified"]},
        "source_binding": {
          "oneOf": [
            {"type": "object", "additionalProperties": false, "required": ["git_revision"], "properties": {"git_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
            {"type": "object", "additionalProperties": false, "required": ["manifest_digest"], "properties": {"manifest_digest": {"$ref": "#/$defs/digest"}}}
          ]
        },
        "catalog": {"$ref": "#/$defs/artifact_ref"},
        "wheel": {"$ref": "#/$defs/artifact_ref"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact_ref"}},
        "destination_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact_ref"}}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["entry_id", "entry_digest", "status", "subject_entry_id", "evidence_type", "approval_state", "evidence_ref"],
      "oneOf": [
        {"properties": {"subject_entry_id": {"pattern": "^candidate:[0-9a-f]{64}$"}, "evidence_type": {"enum": ["review_host_export_acceptance", "review_host_registration_acceptance"]}}},
        {"properties": {"subject_entry_id": {"pattern": "^development:[0-9a-f]{64}$"}, "evidence_type": {"enum": ["development_consumer_acceptance", "development_consumer_recovery_acceptance", "development_host_acceptance", "development_project_case_acceptance"]}}}
      ],
      "properties": {
        "entry_id": {"type": "string", "pattern": "^evidence:[0-9a-f]{64}$"},
        "entry_digest": {"$ref": "#/$defs/digest"},
        "status": {"const": "evidence"},
        "subject_entry_id": {"type": "string"},
        "evidence_type": {"type": "string"},
        "approval_state": {"const": "pending_unapproved"},
        "evidence_ref": {"$ref": "#/$defs/artifact_ref"}
      }
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["entry_id", "entry_digest", "status", "subject_entry_id", "transition", "evidence_ref"],
      "oneOf": [
        {"properties": {"transition": {"const": "superseded"}}, "required": ["successor_entry_id"]},
        {"properties": {"transition": {"const": "withdrawn"}}, "not": {"required": ["successor_entry_id"]}}
      ],
      "properties": {
        "entry_id": {"type": "string", "pattern": "^lifecycle:[0-9a-f]{64}$"},
        "entry_digest": {"$ref": "#/$defs/digest"},
        "status": {"const": "lifecycle"},
        "subject_entry_id": {"type": "string", "pattern": "^(candidate|development):[0-9a-f]{64}$"},
        "transition": {"enum": ["superseded", "withdrawn"]},
        "successor_entry_id": {"type": "string", "pattern": "^(candidate|development):[0-9a-f]{64}$"},
        "evidence_ref": {"$ref": "#/$defs/artifact_ref"}
      }
    },
    "released": {
      "type": "object", "additionalProperties": false,
      "required": ["entry_id", "entry_digest", "status", "predecessor_entry_id", "baseline_entry_id", "included_assets", "manifest_digest"],
      "properties": {
        "entry_id": {"type": "string", "pattern": "^release:.+$"},
        "entry_digest": {"$ref": "#/$defs/digest"},
        "status": {"const": "released"},
        "predecessor_entry_id": {"type": "string", "pattern": "^candidate:[0-9a-f]{64}$"},
        "baseline_entry_id": {"type": ["string", "null"]},
        "included_assets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "manifest_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
