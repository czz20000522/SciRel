{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://scirel.local/contracts/admission/project-final.schema.json",
 "title": "SciRel external project FINAL admission",
 "description": "The single external admission interface. A submission is a decomposition/FINAL directory carrying these bytes; SciRel does not admit D0-D3 packages, stage reports, disposition reviews or capability-gain claims through this interface.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema", "project_id", "decomposition_scope", "limitations",
  "claim_ceiling", "files", "path_map", "root_binding", "payload_files",
  "payload_bytes", "evidence_policy", "custody_note", "license"
 ],
 "properties": {
  "schema": {"const": "scirel.project-final"},
  "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
  "decomposition_scope": {"type": "string", "minLength": 1},
  "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
  "claim_ceiling": {"type": "string", "minLength": 1},
  "files": {"const": "FILES.json"},
  "path_map": {"const": "PATH_MAP.json"},
  "root_binding": {"const": "ROOT.sha256"},
  "payload_files": {"type": "integer", "minimum": 1},
  "payload_bytes": {"type": "integer", "minimum": 1},
  "evidence_policy": {"type": "string", "minLength": 1},
  "custody_note": {"type": "string", "minLength": 1},
  "license": {
   "type": "object",
   "additionalProperties": false,
   "required": ["spdx", "references"],
   "properties": {
    "spdx": {"type": "string", "minLength": 1},
    "references": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
   }
  },
  "identity": {"type": "object", "additionalProperties": {"type": "string"}},
  "stage_evidence": {"type": "object", "additionalProperties": {"type": "string"}},
  "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
  "operators": {"type": "array", "items": {"type": "string", "minLength": 1}},
  "task_graphs": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["directory", "name"],
    "properties": {"directory": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}}
   }
  },
  "platform_boundaries": {"type": "array", "items": {"type": "string", "minLength": 1}}
 }
}
