{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scirel.dev/contracts/automated-check-result-dev.schema.json",
  "title": "SciRel development automated check result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result_id", "candidate_id", "source_digest", "checks", "gaps", "evidence_refs", "status", "next_action"],
  "properties": {
    "schema": {"const": "scirel.automated-check-result.dev"},
    "result_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "source_digest": {"type": "string", "minLength": 1},
    "checks": {"type": "array", "items": {"type": "object"}},
    "gaps": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "status": {"enum": ["passed", "failed"]},
    "next_action": {"enum": ["ready", "retry", "rework_requested", "needs_evidence", "rejected"]}
  }
}
