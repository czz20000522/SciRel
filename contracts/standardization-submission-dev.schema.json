{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scirel.dev/contracts/standardization-submission-dev.schema.json",
  "title": "SciRel development standardization submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "submission_id",
    "draft_id",
    "candidate_id",
    "candidate_digest",
    "source_digest",
    "scirel_git_base",
    "candidate_pool_ref",
    "candidate_pool_digest",
    "producer",
    "review_units",
    "run_evidence",
    "gaps"
  ],
  "properties": {
    "schema": {"const": "scirel.standardization-submission.dev"},
    "submission_id": {"type": "string", "minLength": 1},
    "draft_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_digest": {"$ref": "#/$defs/digest"},
    "source_digest": {"$ref": "#/$defs/digest"},
    "scirel_git_base": {
      "type": "string",
      "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
    },
    "candidate_pool_ref": {"type": "string", "minLength": 1},
    "candidate_pool_digest": {"$ref": "#/$defs/digest"},
    "producer": {"$ref": "#/$defs/producer"},
    "review_units": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/reviewUnit"}
    },
    "run_evidence": {
      "type": "array",
      "items": {"type": "object"}
    },
    "gaps": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "namedVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness", "model", "skill"],
      "properties": {
        "harness": {"$ref": "#/$defs/namedVersion"},
        "model": {"$ref": "#/$defs/namedVersion"},
        "skill": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "digest"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "digest": {"$ref": "#/$defs/digest"}
          }
        }
      }
    },
    "documentMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "digest"],
      "properties": {
        "content": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "codeMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "content", "rationale", "digest"],
      "properties": {
        "kind": {"enum": ["patch", "files", "none"]},
        "content": {},
        "rationale": {"type": "string"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "testMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "commands", "results", "digest"],
      "properties": {
        "content": {},
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "object"}
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "object"}
        },
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "reviewUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_unit_id",
        "source_asset_ids",
        "disposition",
        "asset_document",
        "candidate_document",
        "candidate_code",
        "candidate_tests",
        "dependency_asset_ids",
        "evidence",
        "gaps"
      ],
      "properties": {
        "review_unit_id": {"type": "string", "minLength": 1},
        "source_asset_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "disposition": {
          "enum": [
            "reuse",
            "exact_duplicate",
            "semantic_equivalence",
            "subsumes",
            "overlaps",
            "parameterized_variant",
            "lossless_adapter",
            "composition",
            "new_capability",
            "conflict",
            "unresolved"
          ]
        },
        "asset_document": {"type": "object"},
        "candidate_document": {"$ref": "#/$defs/documentMaterial"},
        "candidate_code": {"$ref": "#/$defs/codeMaterial"},
        "candidate_tests": {"$ref": "#/$defs/testMaterial"},
        "dependency_asset_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {"type": "object"}
        },
        "gaps": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
