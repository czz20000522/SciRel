{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://scirel.local/contracts/handoff/d2-package.schema.json",
 "title": "SciRel handoff package (d2)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "schema_version",
  "layer",
  "package_id",
  "package_version",
  "producer_role",
  "payload_digest",
  "parent_handoff",
  "declarations",
  "claims",
  "evidence_gaps"
 ],
 "properties": {
  "schema": {
   "const": "scirel.handoff-package"
  },
  "schema_version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
  },
  "layer": {
   "const": "d2"
  },
  "package_id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9._-]*$"
  },
  "package_version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
  },
  "producer_role": {
   "type": "string",
   "minLength": 1
  },
  "payload_digest": {
   "type": "string",
   "pattern": "^[a-f0-9]{64}$"
  },
  "parent_handoff": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "layer",
    "package_id",
    "payload_digest",
    "schema_version"
   ],
   "properties": {
    "layer": {
     "const": "d1"
    },
    "package_id": {
     "type": "string",
     "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "payload_digest": {
     "type": "string",
     "pattern": "^[a-f0-9]{64}$"
    },
    "schema_version": {
     "type": "string",
     "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
    }
   }
  },
  "license": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "notice_paths"
   ],
   "properties": {
    "spdx": {
     "type": "string",
     "minLength": 1
    },
    "notice_paths": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\/).+$"
     }
    }
   }
  },
  "declarations": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "scope",
    "coverage",
    "claim_ceiling",
    "not_run",
    "untested_scope",
    "rights",
    "runtime",
    "artifacts"
   ],
   "properties": {
    "scope": {
     "type": "string",
     "minLength": 1
    },
    "coverage": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "covered",
      "failed",
      "blocked",
      "not_run",
      "inapplicable"
     ],
     "properties": {
      "covered": {
       "type": "integer",
       "minimum": 0
      },
      "failed": {
       "type": "integer",
       "minimum": 0
      },
      "blocked": {
       "type": "integer",
       "minimum": 0
      },
      "not_run": {
       "type": "integer",
       "minimum": 0
      },
      "inapplicable": {
       "type": "integer",
       "minimum": 0
      }
     }
    },
    "claim_ceiling": {
     "type": "string",
     "minLength": 1
    },
    "not_run": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "untested_scope": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "rights": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "redistribution",
      "notes"
     ],
     "properties": {
      "redistribution": {
       "enum": [
        "pending",
        "permitted",
        "not_asserted"
       ]
      },
      "notes": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    "runtime": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "dependencies"
     ],
     "properties": {
      "python": {
       "type": "string",
       "minLength": 1
      },
      "dependencies": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1
       }
      },
      "native": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    },
    "artifacts": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "path",
       "sha256"
      ],
      "properties": {
       "path": {
        "type": "string",
        "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\/).+$"
       },
       "sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
       },
       "role": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    }
   }
  },
  "claims": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "claim_id",
     "relation",
     "assumptions",
     "boundary",
     "failure",
     "oracle",
     "observations"
    ],
    "properties": {
     "claim_id": {
      "type": "string",
      "minLength": 1
     },
     "relation": {
      "type": "string",
      "minLength": 1
     },
     "assumptions": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "boundary": {
      "type": "string",
      "minLength": 1
     },
     "failure": {
      "type": "string",
      "minLength": 1
     },
     "oracle": {
      "type": "string",
      "minLength": 1
     },
     "observations": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     }
    }
   }
  },
  "evidence_gaps": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  }
 }
}
