{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://scirel.local/contracts/handoff/disposition.schema.json",
 "title": "SciRel D3 disposition review",
 "type": "object",
 "additionalProperties": false,
 "required": ["schema", "schema_version", "package", "reviewer_role", "decision_ceiling", "summary", "dispositions"],
 "properties": {
  "schema": {"const": "scirel.disposition-review"},
  "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"},
  "package": {
   "type": "object", "additionalProperties": false,
   "required": ["package_id", "payload_digest", "layer"],
   "properties": {
    "package_id": {"type": "string", "minLength": 1},
    "payload_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "layer": {"const": "d3"}
   }
  },
  "reviewer_role": {"type": "string", "minLength": 1},
  "decision_ceiling": {"type": "string", "minLength": 1},
  "summary": {
   "type": "object", "additionalProperties": false,
   "required": ["existing", "partial", "new"],
   "properties": {
    "existing": {"type": "integer", "minimum": 0},
    "partial": {"type": "integer", "minimum": 0},
    "new": {"type": "integer", "minimum": 0}
   }
  },
  "dispositions": {
   "type": "array", "minItems": 1,
   "items": {
    "type": "object", "additionalProperties": false,
    "required": ["incoming_asset_id", "disposition", "matched_asset_ids", "overlap", "differences", "required_changes", "evidence", "notes"],
    "properties": {
     "incoming_asset_id": {"type": "string", "minLength": 1},
     "disposition": {"enum": ["existing", "partial", "new"]},
     "matched_asset_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
     "overlap": {"type": "string", "minLength": 1},
     "differences": {"type": "array", "items": {"type": "string", "minLength": 1}},
     "required_changes": {"type": "array", "items": {"type": "string", "minLength": 1}},
     "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
     "notes": {"type": "string", "minLength": 1}
    }
   }
  }
 }
}
