{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://scirel.local/contracts/handoff/d0-package.schema.json",
 "title": "SciRel handoff package (d0)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "schema_version",
  "layer",
  "package_id",
  "package_version",
  "producer_role",
  "payload_digest",
  "parent_handoff",
  "declarations",
  "source",
  "license"
 ],
 "properties": {
  "schema": {
   "const": "scirel.handoff-package"
  },
  "schema_version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
  },
  "layer": {
   "const": "d0"
  },
  "package_id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9._-]*$"
  },
  "package_version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
  },
  "producer_role": {
   "type": "string",
   "minLength": 1
  },
  "payload_digest": {
   "type": "string",
   "pattern": "^[a-f0-9]{64}$"
  },
  "parent_handoff": {
   "const": null
  },
  "license": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "notice_paths"
   ],
   "properties": {
    "spdx": {
     "type": "string",
     "minLength": 1
    },
    "notice_paths": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\/).+$"
     }
    }
   }
  },
  "declarations": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "scope",
    "coverage",
    "claim_ceiling",
    "not_run",
    "untested_scope",
    "rights",
    "runtime",
    "artifacts"
   ],
   "properties": {
    "scope": {
     "type": "string",
     "minLength": 1
    },
    "coverage": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "covered",
      "failed",
      "blocked",
      "not_run",
      "inapplicable"
     ],
     "properties": {
      "covered": {
       "type": "integer",
       "minimum": 0
      },
      "failed": {
       "type": "integer",
       "minimum": 0
      },
      "blocked": {
       "type": "integer",
       "minimum": 0
      },
      "not_run": {
       "type": "integer",
       "minimum": 0
      },
      "inapplicable": {
       "type": "integer",
       "minimum": 0
      }
     }
    },
    "claim_ceiling": {
     "type": "string",
     "minLength": 1
    },
    "not_run": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "untested_scope": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "rights": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "redistribution",
      "notes"
     ],
     "properties": {
      "redistribution": {
       "enum": [
        "pending",
        "permitted",
        "not_asserted"
       ]
      },
      "notes": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    "runtime": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "dependencies"
     ],
     "properties": {
      "python": {
       "type": "string",
       "minLength": 1
      },
      "dependencies": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1
       }
      },
      "native": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    },
    "artifacts": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "path",
       "sha256"
      ],
      "properties": {
       "path": {
        "type": "string",
        "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\/).+$"
       },
       "sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
       },
       "role": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    }
   }
  },
  "source": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "upstream_identity",
    "source_digest",
    "delta",
    "retained_scope",
    "excluded_scope"
   ],
   "properties": {
    "upstream_identity": {
     "type": "string",
     "minLength": 1
    },
    "source_digest": {
     "type": "string",
     "pattern": "^[a-f0-9]{64}$"
    },
    "delta": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "rationale",
      "patched_files"
     ],
     "properties": {
      "rationale": {
       "type": "string",
       "minLength": 1
      },
      "patched_files": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    },
    "retained_scope": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "excluded_scope": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  }
 }
}
