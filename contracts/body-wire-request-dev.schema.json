{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scirel.dev/contracts/body-wire-request-dev.schema.json",
  "title": "SciRel development body-wire request envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "artifact_ref", "artifact_digest", "media_type", "body"],
  "properties": {
    "operation": {
      "enum": [
        "scirel.import_l1",
        "scirel.automated_check",
        "scirel.review.list_items",
        "scirel.review.open_item",
        "scirel.review.list_completed",
        "plugin.review.action"
      ]
    },
    "artifact_ref": {"type": "string", "minLength": 1},
    "artifact_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "media_type": {"const": "application/json"},
    "body": {"type": "string"},
    "operation_payload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["item_ref", "revision"],
          "properties": {
            "item_ref": {"type": "string", "minLength": 1},
            "revision": {
              "type": "string",
              "pattern": "^sha256:[0-9a-fA-F]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item_ref",
            "revision",
            "extension_ref",
            "action_ref",
            "reviewer",
            "payload"
          ],
          "properties": {
            "item_ref": {"type": "string", "minLength": 1},
            "revision": {
              "type": "string",
              "pattern": "^sha256:[0-9a-fA-F]{64}$"
            },
            "extension_ref": {"const": "scirel.review"},
            "action_ref": {
              "enum": [
                "plugin://scirel/review/approve",
                "plugin://scirel/review/request-evidence",
                "plugin://scirel/review/request-rework",
                "plugin://scirel/review/reject"
              ]
            },
            "reviewer": {
              "type": "object",
              "additionalProperties": false,
              "required": ["actor_ref"],
              "properties": {
                "actor_ref": {"type": "string", "minLength": 1}
              }
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["outcome", "notes"],
              "properties": {
                "outcome": {
                  "enum": [
                    "approved",
                    "needs_evidence",
                    "rework_requested",
                    "rejected"
                  ]
                },
                "notes": {"type": "string"}
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "action_ref": {"const": "plugin://scirel/review/approve"}
                }
              },
              "then": {
                "properties": {
                  "payload": {
                    "properties": {"outcome": {"const": "approved"}}
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "action_ref": {
                    "const": "plugin://scirel/review/request-evidence"
                  }
                }
              },
              "then": {
                "properties": {
                  "payload": {
                    "properties": {"outcome": {"const": "needs_evidence"}}
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "action_ref": {
                    "const": "plugin://scirel/review/request-rework"
                  }
                }
              },
              "then": {
                "properties": {
                  "payload": {
                    "properties": {"outcome": {"const": "rework_requested"}}
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "action_ref": {"const": "plugin://scirel/review/reject"}
                }
              },
              "then": {
                "properties": {
                  "payload": {
                    "properties": {"outcome": {"const": "rejected"}}
                  }
                }
              }
            }
          ]
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "enum": ["scirel.review.open_item", "plugin.review.action"]
          }
        },
        "required": ["operation"]
      },
      "then": {"required": ["operation_payload"]},
      "else": {"not": {"required": ["operation_payload"]}}
    }
  ]
}
