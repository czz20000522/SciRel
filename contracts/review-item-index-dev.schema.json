{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scirel.review-item-index.dev",
  "title": "SciRel bounded review item index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "items", "has_more"],
  "properties": {
    "schema": {"const": "scirel.review-item-index.dev"},
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_ref", "revision", "display_index", "detail_action_ref"],
        "properties": {
          "item_ref": {"type": "string", "minLength": 1},
          "revision": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
          "display_index": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "subtitle"],
            "properties": {
              "title": {"type": "string", "minLength": 1},
              "subtitle": {"type": "string", "minLength": 1}
            }
          },
          "detail_action_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "has_more": {"type": "boolean"}
  }
}
