{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scirel.dev/schemas/scientific-asset-document.v1.json",
  "title": "SciRel scientific asset document v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "asset_id",
    "kind",
    "title",
    "summary",
    "taxonomy",
    "aliases",
    "identity",
    "inputs",
    "outputs",
    "applicability",
    "failure_semantics",
    "provenance",
    "public_api",
    "version",
    "example",
    "verification"
  ],
  "properties": {
    "schema": {"const": "scirel.asset-document.v1"},
    "asset_id": {
      "type": "string",
      "pattern": "^scirel\\.[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
    },
    "kind": {"enum": ["operator", "task_graph"]},
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh"],
      "properties": {
        "en": {"type": "string", "minLength": 1},
        "zh": {"type": "string", "minLength": 1}
      }
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 800},
    "taxonomy": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "identity": {"$ref": "#/$defs/identity"},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/port"}
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/port"}
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preconditions", "supported", "excluded"],
      "properties": {
        "preconditions": {"$ref": "#/$defs/nonemptyStringArray"},
        "supported": {"$ref": "#/$defs/nonemptyStringArray"},
        "excluded": {"$ref": "#/$defs/stringArray"}
      }
    },
    "failure_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invalid_input", "runtime_failure", "nonconvergence", "partial_results"],
      "properties": {
        "invalid_input": {"type": "string", "minLength": 1},
        "runtime_failure": {"type": "string", "minLength": 1},
        "nonconvergence": {"type": "string", "minLength": 1},
        "partial_results": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lineage_summary", "source_kinds", "public_references", "license_status"],
      "properties": {
        "lineage_summary": {"type": "string", "minLength": 1},
        "source_kinds": {"$ref": "#/$defs/nonemptyStringArray"},
        "public_references": {"$ref": "#/$defs/stringArray"},
        "license_status": {"type": "string", "minLength": 1}
      }
    },
    "public_api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python"],
      "properties": {
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": ["module", "symbol", "signature"],
          "properties": {
            "module": {"type": "string", "pattern": "^scirel(?:\\.[A-Za-z_][A-Za-z0-9_]*)+$"},
            "symbol": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
            "signature": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_revision", "implementation_version", "implementation_digest", "dependencies"],
      "properties": {
        "asset_revision": {"type": "string", "minLength": 1},
        "implementation_version": {"type": "string", "minLength": 1},
        "implementation_digest": {"$ref": "#/$defs/digest"},
        "dependencies": {
          "type": "array",
          "items": {"$ref": "#/$defs/dependency"}
        }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "code", "expected"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "code": {"type": "string", "minLength": 1},
        "expected": {"type": "string", "minLength": 1}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "tests", "evidence_ceiling", "known_limitations"],
      "properties": {
        "scope": {"$ref": "#/$defs/nonemptyStringArray"},
        "tests": {"$ref": "#/$defs/nonemptyStringArray"},
        "evidence_ceiling": {"type": "string", "minLength": 1},
        "known_limitations": {"$ref": "#/$defs/nonemptyStringArray"}
      }
    },
    "graph": {"$ref": "#/$defs/graph"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "task_graph"}}},
      "then": {"required": ["graph"]},
      "else": {"not": {"required": ["graph"]}}
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "nonemptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "direction", "definition", "model", "geometry", "coordinates", "boundary", "assumptions"],
      "properties": {
        "relation": {"type": "string", "minLength": 1},
        "direction": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "geometry": {"type": "string", "minLength": 1},
        "coordinates": {"type": "string", "minLength": 1},
        "boundary": {"type": "string", "minLength": 1},
        "assumptions": {"$ref": "#/$defs/stringArray"}
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "units", "shape", "dtype", "required", "constraints"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "description": {"type": "string", "minLength": 1},
        "units": {"type": "string", "minLength": 1},
        "shape": {"type": "string", "minLength": 1},
        "dtype": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "constraints": {"type": "string", "minLength": 1}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "asset_revision", "implementation_digest"],
      "properties": {
        "asset_id": {"type": "string", "pattern": "^scirel\\.[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"},
        "asset_revision": {"type": "string", "minLength": 1},
        "implementation_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "port"],
      "properties": {
        "node": {"type": "string", "minLength": 1},
        "port": {"type": "string", "minLength": 1}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "description", "inputs", "outputs"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "kind": {"enum": ["operator", "task_graph", "controlled_glue", "caller_port"]},
        "asset_id": {"type": "string", "pattern": "^scirel\\.[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"},
        "description": {"type": "string", "minLength": 1},
        "inputs": {"$ref": "#/$defs/stringArray"},
        "outputs": {"$ref": "#/$defs/stringArray"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "description", "condition", "transform", "kind", "required"],
      "properties": {
        "from": {"$ref": "#/$defs/endpoint"},
        "to": {"$ref": "#/$defs/endpoint"},
        "description": {"type": "string", "minLength": 1},
        "condition": {"type": "string", "minLength": 1},
        "transform": {"type": "string", "minLength": 1},
        "kind": {"enum": ["data", "control", "feedback"]},
        "required": {"type": "boolean"}
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "initialization", "update_order", "continue_when", "stop_when", "iteration_bound", "nonconvergence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "state": {"type": "string", "minLength": 1},
        "initialization": {"type": "string", "minLength": 1},
        "update_order": {"type": "string", "minLength": 1},
        "continue_when": {"type": "string", "minLength": 1},
        "stop_when": {"type": "string", "minLength": 1},
        "iteration_bound": {"type": "string", "minLength": 1},
        "nonconvergence": {"type": "string", "minLength": 1}
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges", "execution"],
      "properties": {
        "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
        "edges": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/edge"}},
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "ordering", "branches", "state_ownership", "failure_propagation", "feedback"],
          "properties": {
            "mode": {"type": "string", "minLength": 1},
            "ordering": {"type": "string", "minLength": 1},
            "branches": {"$ref": "#/$defs/stringArray"},
            "state_ownership": {"type": "string", "minLength": 1},
            "failure_propagation": {"type": "string", "minLength": 1},
            "feedback": {"type": "array", "items": {"$ref": "#/$defs/feedback"}}
          }
        }
      }
    }
  }
}
