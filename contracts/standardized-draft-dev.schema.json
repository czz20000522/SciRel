{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scirel.dev/contracts/standardized-draft-dev.schema.json",
  "title": "SciRel development standardized draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "draft_id", "candidate_id", "assets", "dependency_asset_ids", "evidence", "gaps", "status"],
  "properties": {
    "schema": {"const": "scirel.standardized-draft.dev"},
    "draft_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "assets": {"type": "array", "items": {"type": "object"}},
    "dependency_asset_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "gaps": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "status": {"enum": ["draft", "review_pending", "review_in_progress", "needs_evidence", "rework_requested", "rejected", "approved"]}
  }
}
