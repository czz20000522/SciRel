{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scirel.dev/contracts/release-manifest-dev.schema.json",
  "title": "SciRel development release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "release_id", "draft_id", "approved_assets", "catalog_ref", "catalog_digest", "wheel_ref", "wheel_digest", "candidate_id", "candidate_digest", "draft_digest", "release_version"],
  "properties": {
    "schema": {"const": "scirel.release-manifest.dev"},
    "release_id": {"type": "string", "minLength": 1},
    "draft_id": {"type": "string", "minLength": 1},
    "approved_assets": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "catalog_ref": {"type": "string", "minLength": 1},
    "catalog_digest": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
    "wheel_ref": {"type": "string", "minLength": 1},
    "wheel_digest": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_digest": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
    "draft_digest": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
    "release_version": {"type": "string", "minLength": 1}
  }
}
