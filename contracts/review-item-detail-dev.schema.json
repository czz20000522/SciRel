{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scirel.dev/contracts/review-item-detail-dev.schema.json",
  "title": "SciRel read-only exact review item detail",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "item_ref",
    "current_artifact",
    "item",
    "available_actions"
  ],
  "properties": {
    "schema": {"const": "scirel.review-item-detail.dev"},
    "item_ref": {"type": "string", "minLength": 1},
    "current_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_ref", "digest", "media_type"],
      "properties": {
        "artifact_ref": {"type": "string", "minLength": 1},
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "media_type": {"const": "application/json"}
      }
    },
    "item": {"$ref": "review-item-dev.schema.json"},
    "available_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "plugin://scirel/review/approve",
          "plugin://scirel/review/request-evidence",
          "plugin://scirel/review/request-rework",
          "plugin://scirel/review/reject"
        ]
      }
    }
  }
}
