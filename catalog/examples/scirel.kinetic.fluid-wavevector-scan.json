  "relation": "SI equilibrium controls and dimensionless ladder bounds to fluid kx spectra",
  "direction": "SI equilibrium controls and dimensionless ladder bounds to fluid kx spectra",
  "definition": "The graph derives kn and wn from one species equilibrium, builds (omega_scale:omega_step:omega_stop)*wn and kz_scale*kn, and independently solves kx X=M(omega,kz)X at each frequency.",
  "model": "homogeneous magnetized Maxwellian multi-species fluid pole model",
  "geometry": "homogeneous magnetized plasma",
  "coordinates": "wavevector x-z plane, z parallel to B0; frequency is an ordered scan axis",
  "boundary": "J is 8 or 12 and L-pole tables exist only through harmonic 7; every frequency must be nonzero",
  "assumptions": [
   "All species controls describe one shared equilibrium snapshot."
  ]
 },
