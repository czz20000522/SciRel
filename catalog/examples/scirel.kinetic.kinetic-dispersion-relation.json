  "identity": {
    "relation": "SI equilibrium controls and dimensionless probe ratios to two kinetic dispersion tensors",
    "direction": "SI equilibrium controls and dimensionless probe ratios to two kinetic dispersion tensors",
    "definition": "The graph derives omega=omega_frac*wn, kx=kx_frac*kn and f=omega/(2*pi), then evaluates the Weideman sum and Ronnmark paths with shared SI species state.",
    "model": "homogeneous magnetized Maxwellian multi-species plasma",
    "geometry": "homogeneous magnetized plasma",
    "coordinates": "wavevector x-z plane, z parallel to B0; kz is an absolute input",
    "boundary": "the conventional sum clamps |kz|<1e-10 to +1e-10; Ronnmark keeps zero kz",
    "assumptions": [
      "All species controls describe one shared equilibrium snapshot."
    ]
  },
