__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
build/
dist/

# Local machine configuration, credentials and runtime scratch are never source.
/.runtime/
/.scirel/credentials/*
!/.scirel/credentials/README.md

# AOCI agent host integration (machine-bound; do not commit)
.codex/config.toml
.codex/config.toml.backup.*

# Local agent state, editor metadata and generated instruction backups
/.agents/
*.DS_Store
AGENTS.md.backup.*

# Local project assets: method skills and agent instructions stay outside Git
/skills/
/AGENTS.md

# Local generated publish artifacts (HTML site, docs bundle)
/dist/
